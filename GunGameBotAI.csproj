<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GunGameBotAI</AssemblyName>
    <RootNamespace>GunGameBotAI</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <!--
      GeometryProbe is a separate nested diagnostic project. Without this
      exclusion, the root SDK-style project recursively picks up its generated
      obj/*.AssemblyInfo.cs files and produces duplicate assembly attributes.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);GeometryProbe/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.374" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GunGameAPI\GunGameAPI.csproj" />
  </ItemGroup>

</Project>
